# Copy to .env/engine.env and fill in real values before deploying anywhere shared:
#   cp .env/engine.env.example .env/engine.env
#
# Generate secrets with:
#   openssl rand -base64 24   # admin key
#   openssl rand -base64 32   # master key (must decode to exactly 32 bytes)

S3BENDER_ADMIN_API_KEY=
S3BENDER_MASTER_KEY=

# Host[:port] the browser can actually reach, used when building presigned URLs. Without this,
# presigned URLs default to whatever host/port the incoming request appears to target, which can
# be wrong behind a reverse proxy.
S3BENDER_PUBLIC_BASE_URL=http://localhost:8080

# Optional tuning.
# S3BENDER_FRONTEND_PORT=8081
# S3BENDER_CLOCK_SKEW_SECONDS=900
# S3BENDER_MAX_PRESIGN_EXPIRY_SECONDS=604800
