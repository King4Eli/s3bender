S3BENDER_ADMIN_API_KEY= # openssl rand -base64 24 
S3BENDER_MASTER_KEY= # openssl rand -base64 32 # (must decode to exactly 32 bytes)

S3BENDER_PUBLIC_BASE_URL=http://localhost:9066

